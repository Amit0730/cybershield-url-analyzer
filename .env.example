# CyberShield URL Security Analyzer - Environment Variables Example
# Copy this file to .env.local for local development.

# Optional: Google Safe Browsing API v4 Key
# Enable external threat lookup against Google Safe Browsing database
# Leave blank to use CyberShield's built-in heuristic engine
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional: VirusTotal v3 API Key
# Enable external multi-engine antivirus reputation lookup
# Leave blank to use CyberShield's built-in heuristic engine
VIRUSTOTAL_API_KEY=

# Next.js Public App URL (Used for SEO and OpenGraph tags)
NEXT_PUBLIC_APP_URL=https://cybershield-url-analyzer.vercel.app
